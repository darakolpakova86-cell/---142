#include <stdio.h>
#include <math.h>

/**
 * @brief расчет функции A
 *
 * @param x - параметр
 * @param y - параметр
 * @param z - параметр
 * @return значение функции A
 */
double GetA(const double x, const double y, const double z);

/**
 * @brief расчет функции B
 *
 * @param x - параметр
 * @param y - параметр
 * @param z - параметр
 * @return значение функции B
 */
double GetB(const double x, const double y, const double z);

/**
 * @brief точка входа в программу
 *
 * @return возвращает 0 в случае успешного завершения программы
 */
int main()
{
    const double x = 0.3;
    double y = 2.9;
    double z = 0.5;

    printf("A = %lf\n", GetA(x, y, z));
    printf("B = %lf\n", GetB(x, y, z));

    return 0;
}

double GetA(const double x, const double y, const double z)
{
    return (z * z * x + exp(-x) * cos(y * x)) /
           (y * x - exp(-x) * sin(y * x) + 1);
}

double GetB(const double x, const double y, const double z)
{
    return exp(2 * x) * log(z + x) -
           pow(y, 3 * x) * log(y - x);
}
