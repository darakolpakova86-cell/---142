#include <stdio.h>

int main(){
   int a, b;
   int sum, dif;
   double av;

   printf("Enter two integers: ");
   scanf("%d %d", &a, &b);

   sum = a + b;
   dif = a - b;
   av = (a + b) / 2.0;

   printf("Sum = %d\n", sum);
   printf("Dif = %d\n", dif);
   printf("Arifmetic = %.2f\n", av);

   return 0;
}
