#include <stdio.h>
int main(){
    double a, n, b, S, P;

    printf("Введите длину стороны a: ");
    scanf("%lf", &a);

    printf(введиье длину коэффициент n:);
    scanf("%lf", &n);

    b = a * n / 100.0
    S = a * b;
    P = 2 * (a + b);

    printf("Вторая сторона b = %.2f\n", b);
    printf("Площадь прямоугольника S = %.2f\n", S);
    printf("Периметр прямоугольника p = %.2f\n", P);

    return 0;
}
    
