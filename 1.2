#include <stdio.h>

/**
 * @brief Точка входа в программу
 *
 * @return 0 в случае успешного завершения программы
 */
int main()
{
    // Объявляем переменные
    double v_boat;    // Скорость лодки в стоячей воде
    double v_current; // Скорость течения реки
    double t;         // Время движения
    double s;         // Пройденный путь

    // Вводим исходные данные
    printf("Введите скорость лодки в стоячей воде: ");
    scanf("%lf", &v_boat);

    printf("Введите скорость течения реки: ");
    scanf("%lf", &v_current);

    printf("Введите время движения: ");
    scanf("%lf", &t);

    // Вычисляем скорость лодки по течению
    double v = v_boat + v_current;

    // Вычисляем пройденный путь
    s = v * t;

    // Выводим результат
    printf("Путь, пройденный лодкой: %lf\n", s);

    return 0;
}
